<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700&family=Great+Vibes&family=Playfair+Display:ital,wght@0,400;0,500;1,400&display=swap" rel="stylesheet">

<style>

:root {
  --gold: #dfbd79;
  --cream: #fff1dc;
  --wine: #4b142c;
  --dark: #160710;
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  background: var(--dark);
  color: var(--cream);
  font-family: 'Playfair Display', serif;
  overflow-x: hidden;
}

button {
  cursor: pointer;
  font-family: inherit;
}

.hidden {
  display: none !important;
}

.screen {
  min-height: 100vh;
  display: flex;
  justify-content: center;
  align-items: center;
  text-align: center;
  padding: 35px 20px;
  position: relative;
  overflow: hidden;
  background:
    radial-gradient(circle at center, #60253b 0%, #280d1c 55%, #10050c 100%);
}

.content {
  position: relative;
  z-index: 3;
  width: 100%;
  max-width: 750px;
}

.gold {
  color: var(--gold);
}

.script {
  font-family: 'Great Vibes', cursive;
  color: var(--gold);
  font-weight: normal;
}

.eyebrow {
  font-family: Cinzel, serif;
  font-size: 11px;
  letter-spacing: 4px;
  color: var(--gold);
  margin-bottom: 25px;
}

h1 {
  font-family: Cinzel, serif;
  font-weight: 400;
  font-size: clamp(28px, 7vw, 62px);
  letter-spacing: 2px;
}

h2 {
  font-family: Cinzel, serif;
  font-weight: 400;
  font-size: clamp(23px, 5vw, 38px);
}

p {
  font-size: 16px;
  line-height: 1.9;
}

.divider {
  width: 100px;
  height: 1px;
  background: var(--gold);
  margin: 25px auto;
}

.btn {
  background: linear-gradient(135deg, #edcf8e, #a77a39);
  color: #29101a;
  border: 1px solid var(--gold);
  padding: 14px 28px;
  font-family: Cinzel, serif;
  font-size: 11px;
  letter-spacing: 2px;
  margin-top: 25px;
  transition: .3s;
}

.btn:hover {
  transform: scale(1.06);
  box-shadow: 0 0 25px #dfbd7988;
}

.outline {
  background: transparent;
  color: var(--gold);
}

/* PARTICLES */

#particles {
  position: fixed;
  inset: 0;
  pointer-events: none;
  z-index: 2;
}

/* PASSWORD */

.lock {
  font-size: 55px;
  margin-bottom: 25px;
}

input {
  background: #ffffff0c;
  border: 1px solid var(--gold);
  padding: 16px;
  width: min(300px, 90%);
  color: white;
  text-align: center;
  letter-spacing: 3px;
  outline: none;
  margin-top: 25px;
}

#error {
  color: #ff9999;
  margin-top: 15px;
}

/* DOOR */

#doorScreen {
  position: fixed;
  inset: 0;
  z-index: 100;
  min-height: 100vh;
  padding: 0;
  background: #160710;
}

.door-wrapper {
  position: absolute;
  inset: 0;
  display: flex;
  perspective: 1500px;
}

.door {
  width: 50%;
  height: 100%;
  background:
    linear-gradient(90deg, #16060d, #642e27, #270b17);
  border: 5px solid #b78b48;
  box-shadow: inset 0 0 50px #000;
  transition: transform 3s cubic-bezier(.7,0,.2,1);
  position: relative;
}

.door::after {
  content: "✧";
  position: absolute;
  top: 50%;
  font-size: 75px;
  color: var(--gold);
}

.door.left::after {
  right: 20px;
}

.door.right::after {
  left: 20px;
}

#doorScreen.open .left {
  transform: rotateY(-110deg);
  transform-origin: left;
}

#doorScreen.open .right {
  transform: rotateY(110deg);
  transform-origin: right;
}

.door-label {
  position: absolute;
  z-index: 5;
  color: var(--gold);
  font-family: 'Great Vibes', cursive;
  font-size: 55px;
}

/* PP LOGO */

.logo {
  width: 130px;
  height: 130px;
  border: 2px solid var(--gold);
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  margin: 0 auto 35px;
  font-family: 'Great Vibes', cursive;
  font-size: 53px;
  color: var(--gold);
  box-shadow: 0 0 35px #dfbd7955;
  animation: glow 3s infinite alternate;
}

@keyframes glow {
  to {
    box-shadow: 0 0 60px #dfbd79aa;
  }
}

/* NAMES */

.names {
  font-family: 'Great Vibes', cursive;
  font-size: clamp(52px, 12vw, 95px);
  color: var(--gold);
  line-height: 1.4;
}

.and {
  font-family: 'Great Vibes', cursive;
  font-size: 45px;
  color: white;
}

/* SECTIONS */

section:not(.screen) {
  padding: 90px 20px;
  text-align: center;
  position: relative;
  background: linear-gradient(180deg, #200a17, #301020);
}

.section-content {
  max-width: 750px;
  margin: auto;
}

.card {
  border: 1px solid #dfbd7966;
  background: #ffffff08;
  padding: 35px 22px;
  max-width: 570px;
  margin: 30px auto;
  box-shadow: 0 0 35px #0005;
}

/* COUNTDOWN */

.countdown {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 12px;
  margin: 35px 0;
}

.time-box {
  border: 1px solid #dfbd7977;
  padding: 20px 12px;
  min-width: 85px;
  background: #ffffff09;
}

.time-box strong {
  display: block;
  font-family: Cinzel, serif;
  font-size: 27px;
  color: var(--gold);
}

.time-box span {
  font-size: 10px;
  letter-spacing: 2px;
}

/* LOVE GAME */

.hearts {
  display: grid;
  grid-template-columns: repeat(3, 65px);
  justify-content: center;
  gap: 15px;
  margin: 35px auto;
}

.heart-item {
  font-size: 35px;
  background: #ffffff0b;
  border: 1px solid #dfbd7955;
  padding: 12px;
  cursor: pointer;
  transition: .3s;
}

.heart-item:hover {
  transform: scale(1.2);
}

.heart-item.found {
  opacity: .25;
  pointer-events: none;
}

#gameMessage {
  color: var(--gold);
  margin-top: 20px;
}

/* LOVE LETTER */

.envelope {
  font-size: 90px;
  cursor: pointer;
  transition: .4s;
}

.envelope:hover {
  transform: scale(1.15);
}

.letter {
  max-width: 500px;
  margin: 25px auto;
  padding: 30px 22px;
  border: 1px solid var(--gold);
  background: #fff0d8;
  color: #572039;
  animation: fadeIn 1s;
}

.letter h3 {
  font-family: 'Great Vibes', cursive;
  font-size: 38px;
  margin-bottom: 20px;
}

/* UNIVERSE */

.stars {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 30px;
  margin: 40px auto;
}

.star {
  font-size: 40px;
  color: var(--gold);
  cursor: pointer;
  transition: .3s;
  animation: twinkle 2s infinite alternate;
}

.star:hover {
  transform: scale(1.4);
}

@keyframes twinkle {
  from { opacity: .45; }
  to { opacity: 1; }
}

#starMessage {
  color: var(--gold);
  min-height: 55px;
}

/* PROMISE */

.promise {
  font-family: 'Great Vibes', cursive;
  font-size: 36px;
  color: var(--gold);
  line-height: 1.6;
}

/* PETALS */

.petal {
  position: fixed;
  top: -30px;
  color: #e4a0a8;
  z-index: 10;
  pointer-events: none;
  animation: fall linear forwards;
}

@keyframes fall {
  to {
    transform: translateY(110vh) rotate(600deg);
    opacity: 0;
  }
}

/* MUSIC BUTTON */

.music {
  position: fixed;
  top: 15px;
  right: 15px;
  z-index: 110;
  background: #260c1b;
  border: 1px solid var(--gold);
  color: var(--gold);
  padding: 10px 15px;
  border-radius: 30px;
  font-size: 11px;
}

/* ANIMATIONS */

.fade {
  animation: fadeIn 1.5s ease forwards;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(25px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

footer {
  color: #dfbd7999;
  font-family: Cinzel, serif;
  font-size: 10px;
  letter-spacing: 3px;
  margin-top: 45px;
}

@media(max-width:500px) {

  .time-box {
